<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dar Al Shams Documents Clearing Services</title>
    <link rel="stylesheet" href="styles.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Amiri:wght@400;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://www.gstatic.com/firebasejs/8.10.1/firebase-app.js"></script>
    <script src="https://www.gstatic.com/firebasejs/8.10.1/firebase-database.js"></script>
</head>
<body>
    <div id="app-container" class="app-layout">
        <!-- Sidebar Navigation -->
        <aside id="main-sidebar" class="sidebar">
            <div class="sidebar-brand">
                <h2>DAR AL SHAMS</h2>
                <span>CLEARING SERVICES</span>
            </div>
            <ul class="sidebar-menu">
                <li id="nav-dashboard" class="active" onclick="switchTab('dashboard')"><i class="fa-solid fa-chart-line"></i> <span>Dashboard</span></li>
                <li id="nav-works" onclick="switchTab('works')"><i class="fa-solid fa-folder-closed"></i> <span>Works Directory</span></li>
                <li id="nav-clients" onclick="switchTab('clients')"><i class="fa-solid fa-users"></i> <span>Clients Dossier</span></li>
                <li id="nav-documents" onclick="switchTab('documents')"><i class="fa-solid fa-file-invoice"></i> <span>Invoices / Ledger</span></li>
                <li id="nav-quotation" onclick="switchTab('quotation')"><i class="fa-solid fa-file-signature"></i> <span>Quotation View</span></li>
                <li id="nav-services-config" onclick="switchTab('services-config')"><i class="fa-solid fa-gears"></i> <span>Service Tariffs</span></li>
                <li id="nav-accounts-ledger" onclick="switchTab('accounts-ledger')"><i class="fa-solid fa-calculator"></i> <span>Accounts Ledger</span></li>
            </ul>
        </aside>

        <!-- Main Workspace -->
        <main class="main-content">
            <header class="top-bar no-print">
                <button class="icon-btn" onclick="toggleSidebar()"><i class="fa-solid fa-bars"></i></button>
                <div class="top-bar-right">
                    <button class="btn btn-primary" onclick="openStudioForNew()"><i class="fa-solid fa-plus"></i> Create Document</button>
                </div>
            </header>

            <div class="view-space">
                <!-- Dashboard Panel -->
                <div id="tab-dashboard" class="view-panel active">
                    <div class="stats-grid">
                        <div class="stat-card"><h3>Clients</h3><p id="dash-client-count">0</p></div>
                        <div class="stat-card"><h3>Active Works</h3><p id="dash-works-count">0</p></div>
                        <div class="stat-card"><h3>Monthly Volume</h3><p id="dash-monthly-payout">AED 0.00</p></div>
                        <div class="stat-card"><h3>Annual Volume</h3><p id="dash-annual-payout">AED 0.00</p></div>
                    </div>
                </div>

                <!-- Quotation Standby View Panel -->
                <div id="tab-quotation" class="view-panel">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;" class="no-print">
                        <h2 style="color: var(--primary);">Quotation Preview Panel</h2>
                        <button onclick="window.print()" class="btn btn-primary"><i class="fa-solid fa-print"></i> Print Quotation</button>
                    </div>
                    <div id="quotation-panel-content"></div>
                </div>

                <!-- Documents List Panel -->
                <div id="tab-documents" class="view-panel">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px;" class="no-print">
                        <input type="text" id="doc-search-input" placeholder="Search reference, client..." onkeyup="renderDocumentsTable()" style="padding: 8px; border-radius: 6px; border: 1px solid var(--border-color); background: var(--panel-bg); color: #fff; width: 300px;">
                        <span id="ledger-total-amount" style="font-weight: bold; color: var(--primary);">AED 0.00</span>
                    </div>
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th><input type="checkbox" id="select-all-docs" onclick="toggleSelectAllDocs(this)"></th>
                                <th>Ref Code</th>
                                <th>Client</th>
                                <th>Company</th>
                                <th>Branch</th>
                                <th>Description</th>
                                <th style="text-align: center;">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="doc-table-body"></tbody>
                    </table>
                </div>

            </div>
        </main>
    </div>

    <!-- Print & Document Preview Modal -->
    <div id="document-preview-modal" class="modal-backdrop" style="display: none;">
        <div class="modal-content-lg">
            <div class="modal-header no-print" style="display: flex; justify-content: space-between; margin-bottom: 15px;">
                <h3>Document Preview</h3>
                <div style="display: flex; gap: 10px;">
                    <button onclick="window.print()" class="btn btn-primary"><i class="fa-solid fa-print"></i> Print Document</button>
                    <button onclick="document.getElementById('document-preview-modal').style.display='none'" class="btn btn-secondary">Close</button>
                </div>
            </div>
            <div id="p-content-container"></div>
        </div>
    </div>

    <!-- Module Script Loading Order -->
    <script src="config.js"></script>
    <script src="state.js"></script>
    <script src="ui.js"></script>
    <script src="studio.js"></script>
    <script src="services.js"></script>
    <script src="ledger.js"></script>
    <script src="app.js"></script>
</body>
</html>
